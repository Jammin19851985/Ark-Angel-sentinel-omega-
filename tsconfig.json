{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "./global.d.ts",
    "./index.tsx",
    "./App.tsx",
    "./types.ts",
    "./constants.ts",
    "./rag_content.ts",
    "./components/**/*",
    "./contexts/**/*",
    "./hooks/**/*",
    "./services/**/*",
    "./utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "AIToolkit.tsx",
    "Intel.tsx",
    "Nexus.tsx"
  ]
}
